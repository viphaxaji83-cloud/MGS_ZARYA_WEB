# Database
DATABASE_URL=postgresql+asyncpg://zarya:zarya_pass@localhost:5432/zarya_db
DATABASE_URL_SYNC=postgresql://zarya:zarya_pass@localhost:5432/zarya_db

# Auth
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# MinIO / S3
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=zarya-images
S3_REGION=us-east-1

# Frontend
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000
VITE_YANDEX_MAPS_API_KEY=your-yandex-maps-api-key

# Postgres
POSTGRES_USER=zarya
POSTGRES_PASSWORD=zarya_pass
POSTGRES_DB=zarya_db
